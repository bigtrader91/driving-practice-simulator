{
  "name": "driving-practice-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:scoring": "vitest run src/simulation/AttemptAssessment.test.ts src/simulation/TrainingSession.test.ts src/simulation/MissionEvaluator.test.ts",
    "test:physics": "vitest run src/simulation/VehicleMotion.test.ts src/simulation/LaneChangePhysics.test.ts",
    "vehicles:generate": "blender --background --python-exit-code 1 --python assets/blender/generate_vehicles.py -- .",
    "vehicles:prepare-family": "blender --background --python-exit-code 1 --python assets/blender/prepare_vehicle_family.py -- .",
    "vehicles:prepare-traffic": "blender --background --python-exit-code 1 --python assets/blender/prepare_kaykit_traffic.py -- . assets/vehicle-sources/kaykit-city-builder-bits/car_sedan.gltf assets/vehicle-sources/kaykit-city-builder-bits/LICENSE.txt public/models/vehicles/traffic-compact.glb",
    "vehicles:validate": "blender --background --python-exit-code 1 --python assets/blender/validate_vehicles.py -- ."
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
